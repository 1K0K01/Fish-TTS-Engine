<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="4dp">

    <TextView
        android:id="@+id/tvCacheStatusDialog"
        style="@style/Fish.Muted"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLinkCacheFolderDialog"
        style="@style/Fish.Button.Outline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="다른 폴더로 변경" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnClearCacheDialog"
        style="@style/Fish.Button.Destructive"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/clear_cache" />

</LinearLayout>
