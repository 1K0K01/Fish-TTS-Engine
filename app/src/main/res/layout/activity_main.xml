<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_4">

        <!-- 헤더 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_1"
            android:fontFamily="@font/pretendard_bold"
            android:text="Fish TTS Engine"
            android:textColor="@color/foreground"
            android:textSize="20sp" />

        <TextView
            style="@style/Fish.CardDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_6"
            android:text="시스템 TTS 엔진 설정" />

        <!-- 연결 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Fish.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_6">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_5">

                <TextView style="@style/Fish.CardTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="연결" />
                <TextView style="@style/Fish.CardDescription" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:layout_marginBottom="@dimen/space_5" android:text="Fish Audio API에 연결하기 위한 값을 입력합니다." />

                <TextView style="@style/Fish.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="API Key" />
                <EditText android:id="@+id/etApiKey" style="@style/Fish.Input.Mono" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_2" android:layout_marginBottom="@dimen/space_4" android:hint="Fish Audio API Key" android:inputType="textPassword" />

                <TextView style="@style/Fish.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Endpoint" />
                <EditText android:id="@+id/etEndpoint" style="@style/Fish.Input.Mono" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_2" android:layout_marginBottom="@dimen/space_4" android:hint="https://api.fish.audio/v1/tts" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingEnd="@dimen/space_2">
                        <TextView style="@style/Fish.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Model" />
                        <EditText android:id="@+id/etModel" style="@style/Fish.Input.Mono" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_2" android:hint="s2.1-pro" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="@dimen/space_2">
                        <TextView style="@style/Fish.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Locale" />
                        <EditText android:id="@+id/etLocale" style="@style/Fish.Input.Mono" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_2" android:hint="ko-KR" />
                    </LinearLayout>
                </LinearLayout>

                <Space android:layout_width="wrap_content" android:layout_height="@dimen/space_4" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingEnd="@dimen/space_2">
                        <TextView style="@style/Fish.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sample Rate" />
                        <EditText android:id="@+id/etSampleRate" style="@style/Fish.Input.Mono" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_2" android:hint="44100" android:inputType="number" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="@dimen/space_2">
                        <TextView style="@style/Fish.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Format" />
                        <EditText android:id="@+id/etFormat" style="@style/Fish.Input.Mono" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_2" android:hint="pcm 또는 wav" />
                    </LinearLayout>
                </LinearLayout>

                <Space android:layout_width="wrap_content" android:layout_height="@dimen/space_4" />

                <TextView style="@style/Fish.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Chunk 길이" />
                <EditText android:id="@+id/etMaxChunk" style="@style/Fish.Input.Mono" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_2" android:layout_marginBottom="@dimen/space_4" android:hint="900" android:inputType="number" />

                <TextView style="@style/Fish.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="추가 JSON Body" />
                <EditText android:id="@+id/etExtra" style="@style/Fish.Input.Mono" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_2" android:layout_marginBottom="@dimen/space_5" android:hint='예: {&quot;latency&quot;:&quot;normal&quot;}' android:inputType="textMultiLine" android:minLines="2" android:gravity="top" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border" android:layout_marginBottom="@dimen/space_4" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSave"
                    style="@style/Fish.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/save" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 재생 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Fish.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_4">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_5">

                <TextView style="@style/Fish.CardTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="재생" />
                <TextView style="@style/Fish.CardDescription" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:layout_marginBottom="@dimen/space_4" android:text="반복되는 문장을 캐시해 지연을 줄입니다." />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <CheckBox
                        android:id="@+id/cbCache"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/pretendard_regular"
                        android:text="PCM 캐시 사용"
                        android:textColor="@color/foreground"
                        android:textSize="14sp"
                        app:buttonTint="@color/foreground" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 일반 동작 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/space_6">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTest"
                style="@style/Fish.Button.Outline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/space_2"
                android:text="@string/test" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenTts"
                style="@style/Fish.Button.Outline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="@dimen/space_2"
                android:text="TTS 설정" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClearCache"
                style="@style/Fish.Button.Outline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_2"
                android:text="@string/clear_cache" />
        </LinearLayout>

        <!-- 보이스 목록 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Fish.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_6">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_5">

                <TextView style="@style/Fish.CardTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="보이스 목록" />
                <TextView style="@style/Fish.CardDescription" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:layout_marginBottom="@dimen/space_2" android:text="등록된 보이스를 관리합니다." />

                <LinearLayout
                    android:id="@+id/voiceList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 보이스 추가 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Fish.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_4">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_5">

                <TextView style="@style/Fish.CardTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="보이스 추가" />
                <TextView style="@style/Fish.CardDescription" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:layout_marginBottom="@dimen/space_5" android:text="fish.audio에서 발급받은 보이스를 등록합니다." />

                <TextView style="@style/Fish.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="보이스 이름" />
                <EditText android:id="@+id/etNewVoiceName" style="@style/Fish.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_2" android:layout_marginBottom="@dimen/space_4" android:hint="예: 나의 보이스" />

                <TextView style="@style/Fish.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Voice Model ID" />
                <EditText android:id="@+id/etNewVoiceId" style="@style/Fish.Input.Mono" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_2" android:layout_marginBottom="@dimen/space_5" android:hint="fish.audio에서 발급받은 ID" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddVoice"
                    style="@style/Fish.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="보이스 추가" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
